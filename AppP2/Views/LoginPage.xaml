<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppP2.Views.LoginPage"
             Title="Inicio de Sesión">

    <ScrollView>
        <StackLayout Padding="30,50" Spacing="15" VerticalOptions="Center">

            <!-- ✅ LOGO de la App -->
            <Image Source="logo.png"
                   HeightRequest="120"
                   WidthRequest="400"
                   HorizontalOptions="Center"
                   Margin="0,0,0,5"/>

            <Label Text="ProfeView" 
                   FontSize="32" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <Label Text="Califica a tus profesores" 
                   FontSize="16" 
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <!-- Campos -->
            <Entry x:Name="EmailEntry" 
                   Placeholder="Correo electrónico"
                   Keyboard="Email"
                   FontSize="16"/>

            <Entry x:Name="PasswordEntry" 
                   Placeholder="Contraseña"
                   IsPassword="True"
                   FontSize="16"/>

            <!-- Botón Login -->
            <Button Text="Iniciar Sesión" 
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnLoginClicked"/>

            <!-- Link Registro -->
            <Label HorizontalOptions="Center" Margin="0,10,0,0">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="¿No tienes cuenta? " FontSize="14"/>
                        <Span Text="Regístrate" 
                              FontSize="14" 
                              FontAttributes="Bold"
                              TextColor="#2196F3">
                            <Span.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRegisterTapped"/>
                            </Span.GestureRecognizers>
                        </Span>
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!-- Credenciales -->
            <Frame Padding="10" BackgroundColor="#E3F2FD" CornerRadius="8" Margin="0,15,0,0">
                <StackLayout Spacing="3">
                    <Label Text="📝 Credenciales de prueba:" 
                           FontSize="12" 
                           FontAttributes="Bold"
                           TextColor="#1565C0"/>
                    <Label Text="📧 juan@test.com" 
                           FontSize="12" 
                           TextColor="#1565C0"/>
                    <Label Text="🔑 123456" 
                           FontSize="12" 
                           TextColor="#1565C0"/>
                </StackLayout>
            </Frame>
        </StackLayout>
    </ScrollView>
</ContentPage>