<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppP2.Views.MainMenuPage"
             Title="Menú Principal">

    <StackLayout Padding="20" Spacing="20" VerticalOptions="Center">

        <Label Text="📚 ProfeView" 
               FontSize="32" 
               FontAttributes="Bold"
               HorizontalOptions="Center"/>

        <Label Text="Califica a tus profesores" 
               FontSize="16" 
               TextColor="Gray"
               HorizontalOptions="Center"
               Margin="0,0,0,20"/>

        <Button Text="👨‍🏫 Ver Profesores / Agregar Reseña" 
                BackgroundColor="#2196F3"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="OnViewProfessorsClicked"/>

        <Button Text="👨‍🏫 Agregar Profesor" 
                BackgroundColor="#9C27B0"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="OnAddProfessorClicked"/>

        <!-- Botón Mi Perfil - Ahora navega a ProfilePage -->
        <Button Text="👤 Mi Perfil" 
                BackgroundColor="#FF9800"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="OnProfileClicked"/>

        <Button Text="🚪 Cerrar Sesión" 
                BackgroundColor="#FF5722"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="OnLogoutClicked"/>
    </StackLayout>
</ContentPage>