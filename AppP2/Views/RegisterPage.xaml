<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppP2.Views.RegisterPage"
             Title="Registro">

    <ScrollView>
        <StackLayout Padding="30,50" Spacing="15" VerticalOptions="Center">

            <Label Text="📝 Crear Cuenta" 
                   FontSize="28" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <Label Text="Regístrate para comenzar a calificar" 
                   FontSize="14" 
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <!-- Campo: Nombre Completo -->
            <Entry x:Name="FullNameEntry" 
                   Placeholder="Nombre completo"
                   FontSize="16"/>

            <!-- Campo: Email -->
            <Entry x:Name="EmailEntry" 
                   Placeholder="Correo electrónico"
                   Keyboard="Email"
                   FontSize="16"/>

            <!-- Campo: Contraseña -->
            <Entry x:Name="PasswordEntry" 
                   Placeholder="Contraseña"
                   IsPassword="True"
                   FontSize="16"/>

            <!-- Campo: Confirmar Contraseña -->
            <Entry x:Name="ConfirmPasswordEntry" 
                   Placeholder="Confirmar contraseña"
                   IsPassword="True"
                   FontSize="16"/>

            <!-- Botón Registrarse -->
            <Button Text="Registrarse" 
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnRegisterClicked"/>

            <!-- Link a Login -->
            <Label HorizontalOptions="Center" Margin="0,10,0,0">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="¿Ya tienes cuenta? " FontSize="14"/>
                        <Span Text="Inicia Sesión" 
                              FontSize="14" 
                              FontAttributes="Bold"
                              TextColor="#2196F3">
                            <Span.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackToLoginTapped"/>
                            </Span.GestureRecognizers>
                        </Span>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </StackLayout>
    </ScrollView>
</ContentPage>