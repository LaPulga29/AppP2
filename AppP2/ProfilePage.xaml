<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:AppP2.Converters"
             x:Class="AppP2.Views.ProfilePage"
             Title="Mi Perfil">
    
    <Grid RowDefinitions="Auto,Auto,*">
        
        <!-- Información del Usuario -->
        <Frame Grid.Row="0" 
               Padding="20" 
               BackgroundColor="#E3F2FD" 
               CornerRadius="10"
               Margin="15,15,15,10">
            <StackLayout Spacing="8">
                <Label Text="👤 Mi Perfil" 
                       FontSize="20" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                
                <BoxView HeightRequest="1" Color="#BBDEFB"/>
                
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                    <Label Grid.Row="0" Grid.Column="0" 
                           Text="👤 Nombre:" 
                           FontAttributes="Bold"
                           TextColor="#1565C0"/>
                    <Label Grid.Row="0" Grid.Column="1" 
                           x:Name="UserNameLabel"
                           Text="Cargando..."
                           Margin="10,0,0,0"/>
                    
                    <Label Grid.Row="1" Grid.Column="0" 
                           Text="📧 Email:" 
                           FontAttributes="Bold"
                           TextColor="#1565C0"/>
                    <Label Grid.Row="1" Grid.Column="1" 
                           x:Name="UserEmailLabel"
                           Text="Cargando..."
                           Margin="10,0,0,0"/>
                </Grid>
            </StackLayout>
        </Frame>

        <!-- Estadísticas -->
        <Frame Grid.Row="1" 
               Padding="15" 
               BackgroundColor="#F5F5F5" 
               CornerRadius="10"
               Margin="15,0,15,10">
            <Grid ColumnDefinitions="*,*,*">
                <StackLayout HorizontalOptions="Center" Spacing="2">
                    <Label Text="📝" FontSize="24" HorizontalOptions="Center"/>
                    <Label x:Name="TotalReviewsLabel" 
                           Text="0" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label Text="Reseñas" 
                           FontSize="12" 
                           TextColor="Gray"
                           HorizontalOptions="Center"/>
                </StackLayout>
                

                
                <StackLayout HorizontalOptions="Center" Spacing="2">
                    <Label FontSize="24" HorizontalOptions="Center"/>
                    <Label x:Name="ProfessorsCountLabel" 
                           Text="" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                </StackLayout>
            </Grid>
        </Frame>

        <!-- Lista de Reseñas del Usuario -->
        <StackLayout Grid.Row="2" Margin="15,0,15,15">
            <Label Text="📋 Mis Reseñas" 
                   FontSize="16" 
                   FontAttributes="Bold"
                   Margin="0,0,0,10"/>
            
            <CollectionView x:Name="ReviewsCollectionView"
                            ItemsSource="{Binding UserReviews}"
                            EmptyView="No has publicado ninguna reseña aún.">
                
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" 
                               Margin="0,5" 
                               BorderColor="#E0E0E0" 
                               CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Profesor y Fecha -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding ProfessorName}"
                                           FontAttributes="Bold"
                                           FontSize="14"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}"
                                           FontSize="12"
                                           TextColor="Gray"/>
                                </Grid>

                                <!-- Calificación en Estrellas -->
                                <Label Grid.Row="1"
                                       Text="{Binding Rating, Converter={StaticResource StarsConverter}}"
                                       FontSize="16"/>

                                <!-- Comentario -->
                                <Label Grid.Row="2"
                                       Text="{Binding Comment}"
                                       FontSize="14"
                                       Margin="0,5,0,0"/>

                                <!-- Botón Eliminar -->
                                <Button Grid.Row="3"
                                        Text="🗑️ Eliminar"
                                        BackgroundColor="#FF5722"
                                        TextColor="White"
                                        FontSize="12"
                                        CornerRadius="5"
                                        Margin="0,5,0,0"
                                        CommandParameter="{Binding Id}"
                                        Clicked="OnDeleteReviewClicked"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </Grid>
</ContentPage>